# School Bajar Environment Variables
# Copy to schoolbajar-backend/.env and fill in production values.

# Django core
SCHOOLBAJAR_SECRET_KEY=change-me-in-production
SCHOOLBAJAR_DEBUG=False
SCHOOLBAJAR_ALLOWED_HOSTS=schoolbajar.com,localhost

# Database (PostgreSQL + PostGIS)
# Local Docker: compose overrides host to `db`.
# VPS (docker-compose.prod.yml): Postgres already on the host.
SCHOOLBAJAR_DB_NAME=schoolbajar
SCHOOLBAJAR_DB_USER=schoolbajar
SCHOOLBAJAR_DB_PASSWORD=
SCHOOLBAJAR_DB_HOST=127.0.0.1
SCHOOLBAJAR_DB_PORT=5432

# Redis (channel layer + Celery broker)
# Local Docker: compose overrides to redis://redis:6379/0
# VPS: host Redis. Use DB index 1 so other apps on /0 are untouched.
# If Redis has a password: redis://:PASSWORD@127.0.0.1:6379/1
SCHOOLBAJAR_REDIS_URL=redis://127.0.0.1:6379/1

# CORS (comma-separated origins)
SCHOOLBAJAR_CORS_ALLOWED_ORIGINS=https://admin.schoolbajar.example,https://app.schoolbajar.example

# OTP stub (dev bypass code; replace with SMS provider in production)
SCHOOLBAJAR_OTP_BYPASS_CODE=000000

# Cashfree
SCHOOLBAJAR_CASHFREE_APP_ID=
SCHOOLBAJAR_CASHFREE_SECRET_KEY=
SCHOOLBAJAR_CASHFREE_ENV=SANDBOX

# Google Maps Platform (server-side key only — never expose to clients)
SCHOOLBAJAR_GOOGLE_MAPS_SERVER_KEY=

# Firebase FCM (path to service account JSON)
SCHOOLBAJAR_FIREBASE_CREDENTIALS_PATH=/secrets/firebase-service-account.json

# Company info (receipts)
SCHOOLBAJAR_GSTIN=
SCHOOLBAJAR_COMPANY_NAME=School Bajar
SCHOOLBAJAR_COMPANY_ADDRESS=Ahmedabad, Gujarat, India
