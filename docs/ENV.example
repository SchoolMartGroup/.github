# SchoolMart Environment Variables
# Copy to backend/.env and fill in production values.

# Django core
SCHOOLMART_SECRET_KEY=change-me-in-production
SCHOOLMART_DEBUG=False
SCHOOLMART_ALLOWED_HOSTS=api.schoolmart.example,localhost

# Database (PostgreSQL 16 + PostGIS)
SCHOOLMART_DB_NAME=schoolmart
SCHOOLMART_DB_USER=schoolmart
SCHOOLMART_DB_PASSWORD=
SCHOOLMART_DB_HOST=db
SCHOOLMART_DB_PORT=5432

# Redis (channel layer + Celery broker)
SCHOOLMART_REDIS_URL=redis://redis:6379/0

# CORS (comma-separated origins)
SCHOOLMART_CORS_ALLOWED_ORIGINS=https://admin.schoolmart.example,https://app.schoolmart.example

# OTP stub (dev bypass code; replace with SMS provider in production)
SCHOOLMART_OTP_BYPASS_CODE=000000

# Cashfree
SCHOOLMART_CASHFREE_APP_ID=
SCHOOLMART_CASHFREE_SECRET_KEY=
SCHOOLMART_CASHFREE_ENV=SANDBOX

# Google Maps Platform (server-side key only — never expose to clients)
SCHOOLMART_GOOGLE_MAPS_SERVER_KEY=

# Firebase FCM (path to service account JSON)
SCHOOLMART_FIREBASE_CREDENTIALS_PATH=/secrets/firebase-service-account.json

# Company info (receipts)
SCHOOLMART_GSTIN=
SCHOOLMART_COMPANY_NAME=SchoolMart
SCHOOLMART_COMPANY_ADDRESS=Ahmedabad, Gujarat, India
